
# ================== Database Configuration | 数据库配置 ==================
# MySQL connection URL (required for production)
# Format: mysql+aiomysql://user:password@host:port/database
DATABASE_URL=mysql+aiomysql://your_user:your_password@127.0.0.1:3306/ainvestor

# For development, you can use SQLite (no configuration needed)
# The system will automatically create ainvestor.db in the data/ directory

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ================== JWT Configuration | JWT 配置 ==================
# Secret key for JWT token signing (generate a secure random string for production)
# You can generate one with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ================== LLM API Configuration | LLM API 配置 ==================
# OpenAI compatible API (required)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4
MODEL_PROVIDER=OPENAI

# SiliconFlow API (optional alternative)
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# MODEL_NAME=Pro/MiniMaxAI/MiniMax-M2.5
# MODEL_PROVIDER=SILICONFLOW
# SILICONFLOW_API_KEY=your-siliconflow-api-key

# ================== Memory Module | 记忆模块配置 ==================
# Optional: For ReMe long-term memory support
# Uses Aliyun DashScope by default
# More details: https://help.aliyun.com/zh/model-studio/what-is-model-studio
MEMORY_API_KEY=

# ================== MinerU | 年报 PDF 解析 ==================
# 年报/季报 PDF 本地上传解析需要 Precision API Token（必填）
# 申请地址: https://mineru.net/apiManage/docs
# 代码读取: os.getenv("MINERU_API_KEY") → backend/crawler/qualitative_service.py
MINERU_API_KEY=

# ================== Agent-Specific Model Configuration | Agent特定模型配置 ==================
# Configure different base models for different roles | 为不同角色配置不同的基座模型
# If not configured, global MODEL_NAME and MODEL_PROVIDER will be used | 如果未配置，将使用全局MODEL_NAME和MODEL_PROVIDER
#
# Role List | 角色列表：
# - FUNDAMENTALS_ANALYST: Fundamentals Analyst | 基本面分析师
# - VALUATION_ANALYST: Valuation Analyst | 估值分析师
# - PORTFOLIO_MANAGER: Portfolio Manager | 投资组合经理
# - RISK_MANAGER: Risk Manager | 风险管理经理

AGENT_FUNDAMENTALS_ANALYST_MODEL_NAME=
AGENT_VALUATION_ANALYST_MODEL_NAME=
AGENT_RISK_MANAGER_MODEL_NAME=
AGENT_PORTFOLIO_MANAGER_MODEL_NAME=

# ================== Server Configuration | 服务器配置 ==================
API_HOST=0.0.0.0
API_PORT=8000
WS_PORT=8765

# ================== Analysis Configuration | 分析配置 ==================
CONFIG_NAME=default
MAX_COMM_CYCLES=2

# ================== AgentScope Studio (Optional) | Agent 追踪 ==================
# Default: disabled. This endpoint is only reachable by the Python backend,
# not the browser. See deploy/agentscope-studio/ and README for setup.
AGENTSCOPE_STUDIO_ENABLED=false
AGENTSCOPE_STUDIO_ENDPOINT=
AGENTSCOPE_STUDIO_PROJECT=AI Investor

# ================== Valuation V2 | 估值融合配置 ==================
# CAPM / WACC inputs (A-share oriented defaults)
RISK_FREE_RATE=0.025
EQUITY_RISK_PREMIUM=0.065
DEFAULT_COST_OF_DEBT=0.055
DEFAULT_EXIT_EV_EBITDA=14
VALUATION_V2=true

# ================== Segment / SOTP | 分部抽取 ==================
# 年报 Markdown 规则抽取失败时，是否调用 LLM 兜底（需 OPENAI_API_KEY）
SEGMENT_LLM_FALLBACK=true
# 可选：分部抽取专用模型（默认 MODEL_NAME）
# SEGMENT_LLM_MODEL=gpt-4o-mini
